# Copy this file to .env and fill in your own values. Never commit .env to GitHub.
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://redbasket:redbasket@localhost:5432/redbasket
# true = create/update tables automatically from the entities (fine for development)
DB_SYNC=true
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# ---- Google reCAPTCHA v2 checkbox (customer sign up / sign in) ----
# Secret key from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=your-recaptcha-secret-key
# optional: only accept tokens made on this domain, e.g. localhost or redbasket.pk
RECAPTCHA_HOSTNAME=

# ---- OTP SMS through SMS Gateway for Android (https://sms-gate.app, free) ----
# Open the SMSGate app on the Android phone > turn on Cloud Server > copy the username and password shown there
SMSGATE_USERNAME=your-username-from-the-app
SMSGATE_PASSWORD=your-password-from-the-app
